@model RoomReservation.Web.Models.PagedViewModel<RoomReservation.Web.Models.ReservationViewModel>
@{ ViewData["Title"] = "Моите резервации"; Layout = "~/Views/Shared/_Layout.cshtml"; }

<h2 class="mb-4"><i class="bi bi-calendar-check"></i> Моите резервации</h2>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-3">
        <select name="status" class="form-select">
            <option value="">Всички статуси</option>
            @foreach (var s in new[] { "Pending", "Approved", "Rejected", "Cancelled" })
            {
                <option value="@s" selected="@(ViewBag.Status == s)">@s</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-primary w-100">Филтрирай</button>
    </div>
</form>

@if (!Model.Items.Any())
{
    <div class="alert alert-info">
        Нямаш резервации. <a asp-controller="Rooms" asp-action="Index">Разгледай залите</a>.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr><th>#</th><th>Зала</th><th>Начало</th><th>Край</th><th>Цел</th><th>Статус</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Items)
                {
                    <tr>
                        <td>@r.Id</td>
                        <td>@r.Room?.Name</td>
                        <td>@r.StartTime.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@r.EndTime.ToLocalTime().ToString("HH:mm")</td>
                        <td>@r.Purpose</td>
                        <td>
                            @{
                                var bc = r.Status switch { "Pending" => "bg-warning text-dark", "Approved" => "bg-success", "Rejected" => "bg-danger", _ => "bg-secondary" };
                            }
                            <span class="badge @bc">@r.Status</span>
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary">Детайли</a>
                            @if (r.Status == "Pending")
                            {
                                <form method="post" asp-action="Cancel" asp-route-id="@r.Id" class="d-inline" onsubmit="return confirm('Отмени?')">
                                    <button class="btn btn-sm btn-outline-danger">Отмени</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
