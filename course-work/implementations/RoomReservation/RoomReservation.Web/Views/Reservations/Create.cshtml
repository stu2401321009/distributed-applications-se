@model RoomReservation.Web.Models.CreateReservationFormModel
@{ ViewData["Title"] = "Нова резервация"; Layout = "~/Views/Shared/_Layout.cshtml"; }

<h2 class="mb-4"><i class="bi bi-calendar-plus"></i> Нова резервация</h2>

<div class="row">
    <div class="col-md-6">
        @if (Model.ErrorMessage != null)
        {
            <div class="alert alert-danger">@Model.ErrorMessage</div>
        }
        <div class="alert alert-info mb-3">
            <strong>Зала:</strong> @Model.RoomName
        </div>
        <form method="post">
            <input type="hidden" name="RoomId" value="@Model.RoomId" />
            <input type="hidden" name="RoomName" value="@Model.RoomName" />
            <div class="mb-3">
                <label class="form-label">Начало</label>
                <input type="datetime-local" name="StartTime" value="@Model.StartTime.ToString("yyyy-MM-ddTHH:mm")" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Край</label>
                <input type="datetime-local" name="EndTime" value="@Model.EndTime.ToString("yyyy-MM-ddTHH:mm")" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Цел на резервацията</label>
                <input name="Purpose" value="@Model.Purpose" class="form-control" required maxlength="200" placeholder="напр. Лекция по математика" />
            </div>
            <div class="mb-3">
                <label class="form-label">Брой участници</label>
                <input type="number" name="AttendeeCount" value="@Model.AttendeeCount" class="form-control" required min="1" />
            </div>
            <div class="mb-3">
                <label class="form-label">Бележки <small class="text-muted">(по избор)</small></label>
                <textarea name="Notes" class="form-control" rows="2" maxlength="500">@Model.Notes</textarea>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success">Запази резервацията</button>
                <a asp-controller="Rooms" asp-action="Details" asp-route-id="@Model.RoomId" class="btn btn-outline-secondary">Отказ</a>
            </div>
        </form>
    </div>
</div>
