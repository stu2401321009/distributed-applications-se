<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Резервация на зали | ПУ „Паисий Хилендарски“</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        .nav-brand { font-weight: 700; font-size: 1.2rem; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4">
        <div class="container">
            <a class="navbar-brand nav-brand" asp-controller="Rooms" asp-action="Index">
                <i class="bi bi-mortarboard"></i> ПУ „Паисий Хилендарски“
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="nav">
                <ul class="navbar-nav me-auto">
                    @if (Context.Session.GetString("jwt_token") != null)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Rooms" asp-action="Index"><i class="bi bi-grid"></i> Зали</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Rooms" asp-action="Available"><i class="bi bi-search"></i> Търси свободна зала</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Reservations" asp-action="My"><i class="bi bi-calendar-check"></i> Моите резервации</a>
                        </li>
                        @if (Context.Session.GetString("user_role") == "Admin")
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown"><i class="bi bi-gear"></i> Администрация</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="Reservations" asp-action="Index">Всички резервации</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Users">Потребители</a></li>
                                    <li><a class="dropdown-item" asp-controller="Rooms" asp-action="Create">Добави зала</a></li>
                                </ul>
                            </li>
                        }
                    }
                </ul>
                <ul class="navbar-nav">
                    @if (Context.Session.GetString("jwt_token") != null)
                    {
                        <li class="nav-item">
                            <span class="nav-link text-light">
                                <i class="bi bi-person-circle"></i>
                                @Context.Session.GetString("user_name")
                                <span class="badge bg-light text-primary ms-1">@Context.Session.GetString("user_role")</span>
                            </span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Auth" asp-action="Logout"><i class="bi bi-box-arrow-right"></i> Изход</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Auth" asp-action="Login">Вход</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Auth" asp-action="Register">Регистрация</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        }
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
